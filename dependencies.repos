# External repositories of the workshop (version tested on 2026-10-02).
# Usage, from ~/workshop_03/src:   vcs import < dependencies.repos
repositories:
  clearpath_ws/src/clearpath_simulator:
    type: git
    url: https://github.com/clearpathrobotics/clearpath_simulator.git
    version: 199464f0051d4e3cbffe4c744188367a39a38df6  # jazzy branch
  clearpath_ws/src/clearpath_common:
    type: git
    url: https://github.com/clearpathrobotics/clearpath_common.git
    version: 726d7fba367f18e53899d3ac03f0b276380ae847  # jazzy branch
  clearpath_ws/src/clearpath_config:
    type: git
    url: https://github.com/clearpathrobotics/clearpath_config.git
    version: 4897cd1311deabadb887293eb300dcb31e74d666  # jazzy branch
  clearpath_ws/src/clearpath_msgs:
    type: git
    url: https://github.com/clearpathrobotics/clearpath_msgs.git
    version: 797be60abaa140167629f246802c2802a616a495  # jazzy branch
  clearpath_ws/src/clearpath_desktop:
    type: git
    url: https://github.com/clearpathrobotics/clearpath_desktop.git
    version: 0b990c607be45e87eeb072f22c41073b19b0b896  # jazzy branch
  clearpath_ws/src/clearpath_nav2_demos:
    type: git
    url: https://github.com/clearpathrobotics/clearpath_nav2_demos.git
    version: ca2a0996fbdd75d6caa11b4bb22436bf5bdc67fe  # jazzy branch (navigation and mapping)
