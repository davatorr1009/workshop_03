              <instance_material symbol="pared_oliva-material" target="#pared_oliva-material"/>
              <instance_material symbol="pared_terracota-material" target="#pared_terracota-material"/>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
