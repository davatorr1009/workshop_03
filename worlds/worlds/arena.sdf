<?xml version="1.0" ?>
<!-- 6 x 6 m arena for testing trajectories. Centered at the origin, lines every 1 m
     (the dark ones are the x and y axes), 0.80 m walls. -->
<sdf version="1.9">
  <world name="arena">
    <physics type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="libgz-sim-physics-system.so"/>
    <plugin name="gz::sim::systems::UserCommands" filename="libgz-sim-user-commands-system.so"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="libgz-sim-scene-broadcaster-system.so"/>
    <plugin name="gz::sim::systems::Sensors" filename="libgz-sim-sensors-system.so">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Imu" filename="libgz-sim-imu-system.so"/>
    <plugin name="gz::sim::systems::NavSat" filename="libgz-sim-navsat-system.so"/>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.45 0.45 0.43 1</ambient><diffuse>0.45 0.45 0.43 1</diffuse></material>
        </visual>
        <visual name="arena_floor"><pose>0 0 0.0005 0 0 0</pose>
          <geometry><box><size>6.0 6.0 0.001</size></box></geometry>
          <material><ambient>0.9 0.9 0.88 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
        </visual>
        <visual name="line_x_0"><pose>-3 0 0.001 0 0 0</pose><geometry><box><size>0.015 6.0 0.001</size></box></geometry><material><ambient>0.6 0.6 0.58 1</ambient><diffuse>0.6 0.6 0.58 1</diffuse></material></visual>
        <visual name="line_y_0"><pose>0 -3 0.001 0 0 0</pose><geometry><box><size>6.0 0.015 0.001</size></box></geometry><material><ambient>0.6 0.6 0.58 1</ambient><diffuse>0.6 0.6 0.58 1</diffuse></material></visual>
        <visual name="line_x_1"><pose>-2 0 0.001 0 0 0</pose><geometry><box><size>0.015 6.0 0.001</size></box></geometry><material><ambient>0.6 0.6 0.58 1</ambient><diffuse>0.6 0.6 0.58 1</diffuse></material></visual>
        <visual name="line_y_1"><pose>0 -2 0.001 0 0 0</pose><geometry><box><size>6.0 0.015 0.001</size></box></geometry><material><ambient>0.6 0.6 0.58 1</ambient><diffuse>0.6 0.6 0.58 1</diffuse></material></visual>
        <visual name="line_x_2"><pose>-1 0 0.001 0 0 0</pose><geometry><box><size>0.015 6.0 0.001</size></box></geometry><material><ambient>0.6 0.6 0.58 1</ambient><diffuse>0.6 0.6 0.58 1</diffuse></material></visual>
        <visual name="line_y_2"><pose>0 -1 0.001 0 0 0</pose><geometry><box><size>6.0 0.015 0.001</size></box></geometry><material><ambient>0.6 0.6 0.58 1</ambient><diffuse>0.6 0.6 0.58 1</diffuse></material></visual>
        <visual name="line_x_3"><pose>0 0 0.001 0 0 0</pose><geometry><box><size>0.03 6.0 0.001</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material></visual>
        <visual name="line_y_3"><pose>0 0 0.001 0 0 0</pose><geometry><box><size>6.0 0.03 0.001</size></box></geometry><material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material></visual>
        <visual name="line_x_4"><pose>1 0 0.001 0 0 0</pose><geometry><box><size>0.015 6.0 0.001</size></box></geometry><material><ambient>0.6 0.6 0.58 1</ambient><diffuse>0.6 0.6 0.58 1</diffuse></material></visual>
        <visual name="line_y_4"><pose>0 1 0.001 0 0 0</pose><geometry><box><size>6.0 0.015 0.001</size></box></geometry><material><ambient>0.6 0.6 0.58 1</ambient><diffuse>0.6 0.6 0.58 1</diffuse></material></visual>
        <visual name="line_x_5"><pose>2 0 0.001 0 0 0</pose><geometry><box><size>0.015 6.0 0.001</size></box></geometry><material><ambient>0.6 0.6 0.58 1</ambient><diffuse>0.6 0.6 0.58 1</diffuse></material></visual>
        <visual name="line_y_5"><pose>0 2 0.001 0 0 0</pose><geometry><box><size>6.0 0.015 0.001</size></box></geometry><material><ambient>0.6 0.6 0.58 1</ambient><diffuse>0.6 0.6 0.58 1</diffuse></material></visual>
        <visual name="line_x_6"><pose>3 0 0.001 0 0 0</pose><geometry><box><size>0.015 6.0 0.001</size></box></geometry><material><ambient>0.6 0.6 0.58 1</ambient><diffuse>0.6 0.6 0.58 1</diffuse></material></visual>
        <visual name="line_y_6"><pose>0 3 0.001 0 0 0</pose><geometry><box><size>6.0 0.015 0.001</size></box></geometry><material><ambient>0.6 0.6 0.58 1</ambient><diffuse>0.6 0.6 0.58 1</diffuse></material></visual>
      </link>
    </model>

    <model name="arena">
      <static>true</static>
      <link name="link">
        <collision name="wall_north_c"><pose>0 3.05 0.4 0 0 0</pose><geometry><box><size>6.2 0.1 0.8</size></box></geometry></collision>
        <visual name="wall_north_v"><pose>0 3.05 0.4 0 0 0</pose><geometry><box><size>6.2 0.1 0.8</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
        <collision name="wall_south_c"><pose>0 -3.05 0.4 0 0 0</pose><geometry><box><size>6.2 0.1 0.8</size></box></geometry></collision>
        <visual name="wall_south_v"><pose>0 -3.05 0.4 0 0 0</pose><geometry><box><size>6.2 0.1 0.8</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
        <collision name="wall_east_c"><pose>3.05 0 0.4 0 0 0</pose><geometry><box><size>0.1 6.0 0.8</size></box></geometry></collision>
        <visual name="wall_east_v"><pose>3.05 0 0.4 0 0 0</pose><geometry><box><size>0.1 6.0 0.8</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
        <collision name="wall_west_c"><pose>-3.05 0 0.4 0 0 0</pose><geometry><box><size>0.1 6.0 0.8</size></box></geometry></collision>
        <visual name="wall_west_v"><pose>-3.05 0 0.4 0 0 0</pose><geometry><box><size>0.1 6.0 0.8</size></box></geometry><material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
